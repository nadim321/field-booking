NODE_ENV=development
PORT=5000
# Database driver: mysql (default) or postgres (Supabase/PostgreSQL)
DB_DRIVER=mysql
# For PostgreSQL you may use DATABASE_URL instead of DB_HOST/DB_PORT/DB_USER/DB_PASS/DB_NAME.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=booking
DB_PASS=
DB_NAME=turf_booking
JWT_SECRET=replace-with-at-least-32-random-characters
RUN_MIGRATIONS=true
SCHEDULER_ENABLED=true
HOLD_EXPIRY_MINUTES=7
FRONTEND_URL=http://localhost:4200
PAYMENT_PUBLIC_BASE_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5000
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE is written into the release artifact automatically. Override only for a custom deployment.
# Existing payment/email provider variables remain configured in your private .env.
# Only enable SCHEDULER_ENABLED in one application process.

# Required in production: persistent directory outside release ZIP/checkouts
MEDIA_DIR=/var/lib/booking/media

# Mock SMS queue/reminders; never selects a real SMS gateway
NOTIFICATION_WORKER_ENABLED=true
