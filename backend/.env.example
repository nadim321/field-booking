NODE_ENV=development
PORT=5000
# Database driver: mysql (default) or postgres (Supabase/PostgreSQL)
DB_DRIVER=postgres
# For PostgreSQL you may use DATABASE_URL instead of DB_HOST/DB_PORT/DB_USER/DB_PASS/DB_NAME.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# DB_SSL=true
# One-time legacy MySQL -> PostgreSQL import source (set only in your local shell, never in Render):
# SOURCE_MYSQL_HOST=
# SOURCE_MYSQL_PORT=3306
# SOURCE_MYSQL_USER=
# SOURCE_MYSQL_PASSWORD=
# SOURCE_MYSQL_DATABASE=
# SOURCE_MEDIA_DIR=/path/to/old-persistent-media
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=booking
DB_PASS=
DB_NAME=turf_booking
JWT_SECRET=replace-with-at-least-32-random-characters
RUN_MIGRATIONS=true
SCHEDULER_ENABLED=true
HOLD_EXPIRY_MINUTES=7
# Frontend origin used for payment redirects and the /season-booking redirect.
FRONTEND_URL=http://localhost:4200
PAYMENT_PUBLIC_BASE_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5000
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE is written into the release artifact automatically. Override only for a custom deployment.
# Existing payment/email provider variables remain configured in your private .env.
# Only enable SCHEDULER_ENABLED in one application process.

# Required in production: persistent directory outside release ZIP/checkouts
MEDIA_DIR=/var/lib/booking/media

# Booking SMS uses mock mode by default; `json` opts into the HTTPS relay contract below.
BOOKING_SMS_PROVIDER=mock
NOTIFICATION_WORKER_ENABLED=true
# OTP SMS endpoint contract: HTTPS POST JSON {to,message,sender_id,idempotency_key}, Bearer API key.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Optional. Per-SMS price in BDT used for the *estimated* cost on Daily Closing (not an invoice). Leave empty to show "Not set".
SMS_UNIT_COST_BDT=
# Optional. 16+ random characters. Enables POST /api/webhooks/sms-delivery (Authorization: Bearer <secret>) so the provider can report delivered/failed.
SMS_WEBHOOK_SECRET=
# TEMPORARY: logs every OTP (with masked phone) and allows log-based verification when SMS fails.
# Set true only while testing without SMS; turn off after SMS is integrated.
OTP_LOG_CODE=false
OTP_DEBUG_CODE=false
# Set true to require real OTP for slot/season bookings. Defaults to false.
BOOKING_PHONE_OTP_REQUIRED=false
# Demo/dev only: set true to allow the fixed 123456 code for My Bookings login.
# When false (default), My Bookings login uses the real SMS OTP flow.
MY_BOOKINGS_DEMO_CODE_ENABLED=false
# Enable only on the isolated hosted demo service/database. This exposes the demo login to visitors.
DEMO_ADMIN_LOGIN_ENABLED=false
REFUND_WORKER_ENABLED=true
