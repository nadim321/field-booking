{
  "name": "turf-booking-backend",
  "version": "1.0.0",
  "description": "Backend API for Turf Slot Booking System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "migrate": "node scripts/migrate.js",
    "migrate:check": "node scripts/migrate.js --check",
    "seed:dev": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "import:mysql-to-postgres": "node scripts/import-mysql-to-postgres.js",
    "monitor": "node scripts/monitor.js",
    "release": "node scripts/release.js",
    "test:release": "node tests/release-smoke.js",
    "payment:reconcile": "node scripts/reconcile-payment.js",
    "admin:create": "node scripts/create-admin.js",
    "media:cleanup": "node scripts/media-cleanup.js"
  },
  "dependencies": {
    "@sentry/node": "^9.47.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "sslcommerz-lts": "^1.2.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
